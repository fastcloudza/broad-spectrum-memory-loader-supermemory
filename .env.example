# Copy this file to .env and fill in your key. .env is ignored by git.
SUPERMEMORY_API_KEY=

# Optional. When set, namespaces are conv_<HMAC-SHA256 of the customer id> instead of
# conv_<customer id>. Set it whenever the customer id is a phone number, an email
# address or anything else guessable. Keep the same value between runs.
NAMESPACE_SECRET=
